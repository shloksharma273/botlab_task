<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="crazyflie">
    <pose>0 0 0.05 0 0 0</pose>

    <!-- =====================  BODY  ===================== -->
    <link name="crazyflie/body">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000066288</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.000066624</iyy>
          <iyz>0.0</iyz>
          <izz>0.000117048</izz>
        </inertia>
      </inertial>
      <collision name="crazyflie/body_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.10 0.10 0.03</size>
          </box>
        </geometry>
      </collision>
      <visual name="crazyflie/body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://crazyflie/meshes/crazyflie_body.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- =====================  IMU LINK + SENSOR  ===================== -->
    <link name="crazyflie/imu_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-7</ixx>
          <iyy>1e-7</iyy>
          <izz>1e-7</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>
    <joint name="crazyflie/imu_joint" type="fixed">
      <parent>crazyflie/body</parent>
      <child>crazyflie/imu_link</child>
    </joint>

    <!-- =====================  MOTOR LINKS  =====================
         Motor positions (model frame, +X fwd, +Y left, +Z up):
           m1 ( 0.048,-0.048) front-right  CCW
           m2 (-0.048,-0.048) back-right   CW
           m3 (-0.048, 0.048) back-left    CCW
           m4 ( 0.048, 0.048) front-left   CW
         Inertias rewritten as plain numbers (original SDF had
         arithmetic expressions like "2e-9*70" which SDF will not parse).
    -->
    <link name="crazyflie/m1_prop">
      <pose>0.048 -0.048 0.021 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0008</mass>
        <inertia>
          <ixx>2e-9</ixx>
          <iyy>1.67e-7</iyy>
          <izz>1.68e-7</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m1_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://crazyflie/meshes/crazyflie_ccw_propeller.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="crazyflie/m2_prop">
      <pose>-0.048 -0.048 0.021 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0008</mass>
        <inertia>
          <ixx>2e-9</ixx>
          <iyy>1.67e-7</iyy>
          <izz>1.68e-7</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m2_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://crazyflie/meshes/crazyflie_cw_propeller.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="crazyflie/m3_prop">
      <pose>-0.048 0.048 0.021 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0008</mass>
        <inertia>
          <ixx>2e-9</ixx>
          <iyy>1.67e-7</iyy>
          <izz>1.68e-7</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m3_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://crazyflie/meshes/crazyflie_ccw_propeller.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="crazyflie/m4_prop">
      <pose>0.048 0.048 0.021 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0008</mass>
        <inertia>
          <ixx>2e-9</ixx>
          <iyy>1.67e-7</iyy>
          <izz>1.68e-7</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="crazyflie/m4_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://crazyflie/meshes/crazyflie_cw_propeller.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- =====================  MOTOR JOINTS  ===================== -->
    <joint name="crazyflie/m1_joint" type="revolute">
      <parent>crazyflie/body</parent>
      <child>crazyflie/m1_prop</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="crazyflie/m2_joint" type="revolute">
      <parent>crazyflie/body</parent>
      <child>crazyflie/m2_prop</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="crazyflie/m3_joint" type="revolute">
      <parent>crazyflie/body</parent>
      <child>crazyflie/m3_prop</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="crazyflie/m4_joint" type="revolute">
      <parent>crazyflie/body</parent>
      <child>crazyflie/m4_prop</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.0001</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- =====================  PLUGINS  ===================== -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- Apply-joint-force lets the ArduPilotPlugin drive each rotor joint.
         One per motor. -->
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>crazyflie/m1_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>crazyflie/m2_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>crazyflie/m3_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system"
            name="gz::sim::systems::ApplyJointForce">
      <joint_name>crazyflie/m4_joint</joint_name>
    </plugin>

    <!-- Lift-drag: 2 blades per rotor.
         Crazyflie prop diameter ≈ 45 mm, so cp ≈ ±0.012 m from hub.
         area ≈ blade-area scaled from iris (iris=0.002 for 10" prop;
         crazyflie ~1.8" prop ⇒ area shrinks ~25x ⇒ ~8e-5).
         CCW rotor: forward=+Y / -Y on the two blades.
         CW  rotor: forward=-Y / +Y (mirror).
    -->
    <!-- ===== m1 (CCW) ===== -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>4e-4</area><air_density>1.2041</air_density>
      <cp>0.012 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>crazyflie/m1_prop</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>4e-4</area><air_density>1.2041</air_density>
      <cp>-0.012 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>crazyflie/m1_prop</link_name>
    </plugin>

    <!-- ===== m2 (CW) ===== -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>4e-4</area><air_density>1.2041</air_density>
      <cp>0.012 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>crazyflie/m2_prop</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>4e-4</area><air_density>1.2041</air_density>
      <cp>-0.012 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>crazyflie/m2_prop</link_name>
    </plugin>

    <!-- ===== m3 (CCW) ===== -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>4e-4</area><air_density>1.2041</air_density>
      <cp>0.012 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>crazyflie/m3_prop</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>4e-4</area><air_density>1.2041</air_density>
      <cp>-0.012 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>crazyflie/m3_prop</link_name>
    </plugin>

    <!-- ===== m4 (CW) ===== -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>4e-4</area><air_density>1.2041</air_density>
      <cp>0.012 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>crazyflie/m4_prop</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla><cda>0.10</cda><cma>0.0</cma>
      <cla_stall>-0.025</cla_stall><cda_stall>0.0</cda_stall><cma_stall>0.0</cma_stall>
      <area>4e-4</area><air_density>1.2041</air_density>
      <cp>-0.012 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>crazyflie/m4_prop</link_name>
    </plugin>

    <!-- =====================  ARDUPILOT BRIDGE  =====================
         Motor → channel mapping (ArduCopter quad-X convention):
           channel 0 = MOT_1 front-right CCW  → m1_joint
           channel 1 = MOT_2 back-left  CCW  → m3_joint
           channel 2 = MOT_3 front-left CW   → m4_joint
           channel 3 = MOT_4 back-right CW   → m2_joint
         multiplier sign encodes spin direction (positive = CCW like iris).
         |multiplier| ≈ peak rotor velocity in rad/s (≈ 25000 RPM ≈ 2618 rad/s).
    -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <have_32_channels>0</have_32_channels>

      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <imuName>crazyflie/imu_link::imu_sensor</imuName>

      <control channel="0">
        <jointName>crazyflie/m1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>2618</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.02</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <controlVelocitySlowdownSim>0</controlVelocitySlowdownSim>
      </control>

      <control channel="1">
        <jointName>crazyflie/m3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>2618</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.02</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <controlVelocitySlowdownSim>0</controlVelocitySlowdownSim>
      </control>

      <control channel="2">
        <jointName>crazyflie/m4_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-2618</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.02</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <controlVelocitySlowdownSim>0</controlVelocitySlowdownSim>
      </control>

      <control channel="3">
        <jointName>crazyflie/m2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-2618</multiplier>
        <offset>0</offset>
        <servo_min>1000</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.02</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>0.5</cmd_max>
        <cmd_min>-0.5</cmd_min>
        <controlVelocitySlowdownSim>0</controlVelocitySlowdownSim>
      </control>

      <!-- channel 4 = SERVO5 in ArduPilot (1-indexed).
           MNT1_PITCH drives this output.
           PWM 1000→1500→2000 maps to -π/2→0→+π/2 rad (pitch down→level→up). -->
      <control channel="4">
        <jointName>gimbal_tilt_joint</jointName>
        <useForce>0</useForce>
        <multiplier>3.14159</multiplier>
        <offset>-1.5708</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>POSITION</type>
      </control>
    </plugin>

    <!-- =====================  GIMBAL  =====================
         gimbal_small_1d scaled to fit a Crazyflie (mesh scale 0.0003 = 3× smaller
         than the original 0.001).  Total payload: 15 g base + 5 g tilt = 20 g.

         Rotation: roll = -1.5708 rad (-90°) on gimbal_base so the arm that
         originally extended in the local +Y direction now points straight down
         (-Z world), hanging the camera below the drone.

         The gimbal_base origin sits 3 cm below the crazyflie/body centre
         (body bottom is at -1.5 cm, so the mount clears the body by 1.5 cm).
    -->
    <link name="gimbal_base">
      <pose>0.01 0 -0.03 -1.5708 -3.14 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>7.5e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>7.5e-6</iyy><iyz>0</iyz>
          <izz>7.5e-6</izz>
        </inertia>
      </inertial>
      <visual name="gimbal_base_main_viz">
        <geometry>
          <mesh>
            <scale>0.0003 0.0003 0.0003</scale>
            <uri>model://gimbal_small_1d/meshes/base_main.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1</ambient>
          <diffuse>0.1 0.1 0.1</diffuse>
          <specular>0.01 0.01 0.01 1.0</specular>
        </material>
      </visual>
      <visual name="gimbal_base_arm_viz">
        <geometry>
          <mesh>
            <scale>0.0003 0.0003 0.0003</scale>
            <uri>model://gimbal_small_1d/meshes/base_arm.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1</ambient>
          <diffuse>0.1 0.1 0.1</diffuse>
          <specular>0.01 0.01 0.01 1.0</specular>
        </material>
      </visual>
      <collision name="gimbal_base_col">
        <pose>0.003 0.0225 -0.0075 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.015 0.045</size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name="gimbal_tilt">
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>5e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5e-6</iyy><iyz>0</iyz>
          <izz>5e-6</izz>
        </inertia>
      </inertial>
      <visual name="gimbal_tilt_viz">
        <pose>0 0 -0.0015 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.0003 0.0003 0.0003</scale>
            <uri>model://gimbal_small_1d/meshes/tilt.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4</ambient>
          <diffuse>0.4 0.4 0.4</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="gimbal_tilt_col">
        <pose>0 0 -0.0015 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.0003 0.0003 0.0003</scale>
            <uri>model://gimbal_small_1d/meshes/tilt.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <visual name="gimbal_camera_viz">
        <pose>0 0 0.006 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0075</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4</ambient>
          <diffuse>0.4 0.4 0.4</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="gimbal_camera_col">
        <pose>0 0 0.006 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0075</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="gimbal_camera" type="camera">
        <topic>/gimbal_camera</topic>
        <pose degrees="true">0 0 0 -90 -90 0</pose>
        <camera>
          <horizontal_fov>2.0</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>1</visualize>
        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5600</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>
    </link>

    <!-- Fixed joint: drone body → gimbal base -->
    <joint name="gimbal_attach_joint" type="fixed">
      <parent>crazyflie/body</parent>
      <child>gimbal_base</child>
    </joint>

    <!-- Gimbal pitch joint — rotates tilt_link around the X axis -->
    <joint name="gimbal_tilt_joint" type="revolute">
      <parent>gimbal_base</parent>
      <child>gimbal_tilt</child>
      <pose>0 0 0.006 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
        <limit>
          <lower>-3.1415926</lower>
          <upper>3.1415926</upper>
        </limit>
      </axis>
    </joint>

  </model>
</sdf>
